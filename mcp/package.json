{
  "name": "mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Bottle Note Admin MCP gateway (isolated). Clients <-> MCP <-> Admin API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
